---
import type { StoreLink } from '../data/apps';

interface Props {
  store: 'android' | 'ios';
  link: StoreLink;
  id?: string;
  /** Accessible name for a live badge link, e.g. "Get Lodestra on Google Play". Defaults to the badge's alt text. */
  label?: string;
}

const { store, link, id, label } = Astro.props;

// Official artwork, unaltered. Only placement, size and the coming-soon dimming change.
const badges = {
  android: {
    src: 'https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png',
    alt: 'Get it on Google Play',
    name: 'Google Play',
    // The PNG carries ~16% transparent padding on every side. Scale it up and pull the
    // padding in with negative margins so the visible badge is 40px tall, like Apple's.
    img: 'h-[60px] w-auto max-w-none -m-[10px]',
  },
  ios: {
    src: 'https://developer.apple.com/app-store/marketing/guidelines/images/badge-download-on-the-app-store.svg',
    alt: 'Download on the App Store',
    name: 'App Store',
    img: 'h-10 w-auto max-w-none',
  },
}[store];
---

{
  link.status === 'live' ? (
    <a
      href={link.url}
      id={id}
      aria-label={label}
      class="ring-accent inline-flex h-10 shrink-0 items-center rounded-md transition-opacity duration-150 hover:opacity-90 active:opacity-80 active:transition-none"
    >
      <img src={badges.src} alt={badges.alt} class={badges.img} decoding="async" />
    </a>
  ) : (
    <span data-coming-soon id={id} class="inline-flex shrink-0 flex-col items-start gap-1">
      <span class="inline-flex h-10 items-center opacity-50">
        <img src={badges.src} alt={badges.name} class={badges.img} loading="lazy" decoding="async" />
      </span>
      <span class="text-xs leading-[1.5] tracking-[0.4px] text-mute">Coming soon</span>
    </span>
  )
}
