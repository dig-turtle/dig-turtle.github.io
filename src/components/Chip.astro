---
interface Props {
  label: string;
  href?: string;
}

const { label, href } = Astro.props;
const base = 'rounded-xs border border-hairline bg-surface-card px-2 py-0.5 text-xs leading-[1.5] text-body';
---

{
  href ? (
    <a data-chip href={href} class={`${base} ring-accent hover:text-ink`}>
      {label}
    </a>
  ) : (
    <span data-chip class={base}>
      {label}
    </span>
  )
}
