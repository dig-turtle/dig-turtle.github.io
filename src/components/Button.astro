---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  id?: string;
  hidden?: boolean;
}

const { href, variant = 'primary', id, hidden = false } = Astro.props;

const variants = {
  primary: 'bg-primary text-on-primary hover:opacity-90 active:opacity-80',
  secondary: 'border border-hairline text-ink hover:bg-surface-elevated active:bg-surface-card',
};
---

<a
  href={href}
  id={id}
  hidden={hidden}
  class:list={[
    'ring-accent inline-flex h-10 items-center justify-center gap-2 rounded-full px-4 text-sm leading-[1.6] font-medium tracking-[0.2px] transition duration-150 active:transition-none',
    variants[variant],
  ]}
>
  <slot />
</a>
