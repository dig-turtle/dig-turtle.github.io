---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  footerLinks?: { href: string; label: string }[];
}

const { title, description, noindex = false, footerLinks = [] } = Astro.props;

const links = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-of-service', label: 'Terms of Service' },
  ...footerLinks,
];
---

<!doctype html>
<html lang="en" class="bg-canvas">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <!-- Lets iOS Safari apply :active on tap, so app rows flash their neon state. -->
    <script is:inline>document.addEventListener('touchstart',function(){},{passive:true})</script>
  </head>
  <body class="min-h-screen">
    <div class="relative isolate flex min-h-screen flex-col overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="glow-from absolute -top-48 -right-48 size-[28rem] sm:-top-64 sm:-right-64 sm:size-[44rem]"></div>
        <div class="glow-to absolute -bottom-48 -left-48 size-[26rem] sm:-bottom-64 sm:-left-64 sm:size-[40rem]"></div>
      </div>

      <header class="mx-auto flex h-14 w-full max-w-3xl items-center px-4 sm:px-6">
        <a
          href="/"
          class="ring-accent -mx-1 rounded-sm px-1 text-base leading-[1.4] font-medium tracking-[0.2px] text-ink"
        >
          Made With Pixels
        </a>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="border-t border-hairline">
        <div
          class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 py-8 text-sm leading-[1.6] text-mute sm:flex-row sm:items-center sm:justify-between sm:px-6"
        >
          <p>© 2026 Made With Pixels, LLC</p>
          <nav aria-label="Legal">
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
              {
                links.map((link) => (
                  <li>
                    <a href={link.href} class="ring-accent rounded-xs transition-colors duration-150 hover:text-ink">
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
