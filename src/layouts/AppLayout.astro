---
import Layout from './Layout.astro';
import StoreBadge from '../components/StoreBadge.astro';
import Chip from '../components/Chip.astro';
import { dataUseInfo, type App } from '../data/apps';

interface Props {
  app: App;
  /** Overrides the default `{name} - {description}` page title. */
  title?: string;
}

const { app, title = `${app.name} - ${app.description}` } = Astro.props;
---

<Layout title={title} description={app.description}>
  <section class="mx-auto w-full max-w-3xl px-4 pt-12 pb-12 sm:px-6 md:pt-16 md:pb-16 lg:pt-24 lg:pb-24">
    <p class="mb-4 font-mono text-xs leading-[1.5] tracking-[0.12em] text-mute uppercase">An app by Made With Pixels</p>
    <h1
      class="text-gradient-accent text-[2.5rem] leading-[1.17] font-medium tracking-[0.2px] sm:text-5xl lg:text-[3.5rem]"
    >
      {app.name}
    </h1>
    <p class="mt-3 text-lg leading-[1.6] text-mute">{app.description}</p>

    <div class="mt-10 rounded-lg border border-hairline bg-surface p-6 sm:p-8">
      <p class="text-base leading-[1.6] text-body">{app.about}</p>
      <div class="mt-6 flex flex-wrap items-start gap-3">
        <StoreBadge store="android" link={app.stores.android} label={`Get ${app.name} on Google Play`} />
        <StoreBadge store="ios" link={app.stores.ios} label={`Download ${app.name} on the App Store`} />
      </div>
    </div>
    <p class="mt-6 text-sm leading-[1.6]">
      <a
        href="/privacy-policy"
        class="ring-accent rounded-xs text-mute underline underline-offset-2 transition-colors duration-150 hover:text-ink"
        >How {app.name} handles your data</a
      >
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      {
        app.dataUses.map((use) => (
          <Chip label={dataUseInfo[use].label} href={`/privacy-policy#${dataUseInfo[use].anchor}`} />
        ))
      }
    </div>
  </section>
</Layout>
