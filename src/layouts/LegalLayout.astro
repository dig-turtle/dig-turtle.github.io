---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
  footerLinks?: { href: string; label: string }[];
}

const { title, description, heading, updated, footerLinks } = Astro.props;
---

<Layout title={title} description={description} footerLinks={footerLinks}>
  <article class="mx-auto w-full max-w-prose px-4 pt-12 pb-16 sm:px-6 md:pt-16 md:pb-24">
    <h1 class="text-gradient-accent text-[2rem] leading-[1.17] font-medium tracking-[0.2px] sm:text-4xl">{heading}</h1>
    <p class="mt-3 text-xs leading-[1.5] text-mute">Last updated: {updated}</p>

    <div
      class="mt-10 text-base leading-[1.6] text-body [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-2 [&_a]:ring-accent [&_a]:rounded-xs [&_code]:font-mono [&_code]:text-sm [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:leading-[1.6] [&_h2]:font-medium [&_h2]:text-ink [&_h2]:accent-bar [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:leading-[1.4] [&_h3]:font-medium [&_h3]:text-ink [&_li]:mt-2 [&_p]:mt-4 [&_strong]:font-medium [&_strong]:text-ink [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6 [&>section:first-child>h2]:mt-0"
    >
      <slot />
    </div>
  </article>
</Layout>
