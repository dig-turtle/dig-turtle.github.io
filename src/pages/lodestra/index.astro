---
import Layout from '../../layouts/Layout.astro';
import StoreBadge from '../../components/StoreBadge.astro';
import { apps } from '../../data/apps';

const lodestra = apps.find((app) => app.name === 'Lodestra')!;
---

<Layout
  title="Lodestra - Trip Organizer"
  description="Lodestra is a trip organizer for Android. Plan your itinerary and share trips with the people you travel with."
  footerLinks={[{ href: '/lodestra/privacy-policy', label: 'Lodestra Privacy Policy' }]}
>
  <section class="mx-auto w-full max-w-3xl px-4 pt-12 pb-12 sm:px-6 md:pt-16 md:pb-16 lg:pt-24 lg:pb-24">
    <p class="mb-4 font-mono text-xs leading-[1.5] tracking-[0.12em] text-mute uppercase">An app by Made With Pixels</p>
    <h1 class="text-[2.5rem] leading-[1.17] font-medium tracking-[0.2px] text-ink sm:text-5xl lg:text-[3.5rem]">
      Lodestra
    </h1>
    <p class="mt-3 text-lg leading-[1.6] text-mute">A trip organizer for Android</p>

    <div class="mt-10 rounded-lg border border-hairline bg-surface p-6 sm:p-8">
      <p class="text-base leading-[1.6] text-body">
        Keep flights, stays, reservations and plans for each trip in one timeline. Your trips are backed up to your own
        Google Drive, and you can share a trip with the people you're travelling with.
      </p>
      <p class="mt-4 text-sm leading-[1.6] text-mute">Coming soon to Google Play.</p>
      <div class="mt-6 flex flex-wrap items-start gap-3">
        <StoreBadge store="android" link={lodestra.stores.android} />
        <StoreBadge store="ios" link={lodestra.stores.ios} />
      </div>
    </div>
  </section>
</Layout>
