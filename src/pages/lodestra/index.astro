---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="bg-gray-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Lodestra - Trip Organizer</title>
		<meta name="description" content="Lodestra is a trip organizer for Android. Plan your itinerary and share trips with the people you travel with." />
	</head>
	<body class="min-h-screen flex flex-col items-center justify-center p-4 text-white">
		<main class="max-w-4xl mx-auto text-center">
			<a href="/" class="text-purple-400 hover:text-purple-300 mb-8 inline-block">← All apps</a>

			<h1 class="text-6xl font-bold mb-6 bg-gradient-to-r from-purple-400 to-pink-600 text-transparent bg-clip-text">
				Lodestra
			</h1>

			<p class="text-2xl mb-8 text-gray-300">
				A trip organizer for Android
			</p>

			<div class="bg-gray-800 p-8 rounded-xl shadow-2xl">
				<p class="text-gray-300 mb-4">
					Keep flights, stays, reservations and plans for each trip in one timeline. Your trips are backed up to your own Google Drive, and you can share a trip with the people you're travelling with.
				</p>
				<p class="text-gray-400">Coming soon to Google Play.</p>
			</div>
		</main>

		<footer class="mt-16 text-gray-400 text-sm">
			<p>© 2026 Dig Turtle & Filicode. All rights reserved. | <a href="/lodestra/privacy-policy" class="hover:text-purple-400">Lodestra Privacy Policy</a></p>
		</footer>
	</body>
</html>
