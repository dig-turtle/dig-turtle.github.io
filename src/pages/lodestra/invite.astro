---
import Layout from '../../layouts/Layout.astro';
import StoreBadge from '../../components/StoreBadge.astro';
import Button from '../../components/Button.astro';

// Lodestra opens this URL directly when it's installed (Android App Links, verified by
// /.well-known/assetlinks.json). This page is only the fallback for everyone else.
const playUrl = 'https://play.google.com/store/apps/details?id=io.bwvolleyball.lodestra';
---

<Layout
  title="Trip invite - Lodestra"
  noindex
  footerLinks={[
    { href: '/lodestra', label: 'About Lodestra' },
    { href: '/lodestra/privacy-policy', label: 'Lodestra Privacy Policy' },
  ]}
>
  <section class="mx-auto w-full max-w-3xl px-4 pt-12 pb-12 sm:px-6 md:pt-16 md:pb-16 lg:pt-24 lg:pb-24">
    <h1
      class="text-gradient-accent text-[2.5rem] leading-[1.1] font-semibold sm:text-[3.5rem] lg:text-[4rem]"
    >
      Lodestra Trip Invite
    </h1>
    <p
      id="headline"
      class="mt-4 text-lg leading-[1.4] font-medium tracking-[0.2px] text-ink [overflow-wrap:anywhere] break-words sm:text-xl"
    >
      You've been invited to a trip
    </p>

    <div class="mt-10 rounded-lg border border-hairline bg-surface p-6 sm:p-8">
      <p id="detail" class="text-base leading-[1.6] text-body">
        Someone shared a trip with you in Lodestra, a trip organizer for Android.
      </p>
      <p class="mt-4 text-sm leading-[1.6] text-mute">
        Install Lodestra, then tap the invite link again to open the trip.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <StoreBadge store="android" link={{ status: 'live', url: playUrl }} id="play" />
        <Button id="open" href="#" hidden>Open in Lodestra</Button>
      </div>
    </div>
  </section>

		<script is:inline define:vars={{ playUrl }}>
			// The invite details live in the #fragment, which browsers never send to the server.
			// They come from the link itself, so they're untrusted and only ever set as textContent.
			(function () {
				var raw = location.hash.slice(1);
				if (!raw) return;
				var params = new URLSearchParams(raw);
				var name = params.get('n');
				var by = params.get('by');
				var role = { writer: 'an editor', reader: 'a viewer' }[params.get('r')];
				if (name) {
					document.getElementById('headline').textContent =
						by ? by + ' shared “' + name + '” with you' : 'You\'ve been invited to “' + name + '”';
					document.title = name + ' - Lodestra invite';
				}
				if (role) {
					document.getElementById('detail').textContent =
						'You\'ve been added as ' + role + '. Open the trip in Lodestra, a trip organizer for Android.';
				}
				// Play passes the referrer to the app after install (Play Install Referrer API).
				var invite = location.origin + location.pathname.replace(/\/$/, '') + '#' + raw;
				var play = playUrl + '&referrer=' + encodeURIComponent(invite);
				document.getElementById('play').href = play;
				if (/Android/i.test(navigator.userAgent)) {
					var open = document.getElementById('open');
					// An intent:// URL's own #fragment holds the Intent syntax, so the invite rides in the query here.
					open.href = 'intent://' + location.host + location.pathname.replace(/\/$/, '') + '?' + raw + '#Intent;scheme=https;package=io.bwvolleyball.lodestra;S.browser_fallback_url=' + encodeURIComponent(play) + ';end';
					open.hidden = false;
				}
			})();
		</script>
</Layout>
