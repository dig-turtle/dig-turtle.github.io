---
import Layout from '../layouts/Layout.astro';
import AppRow from '../components/AppRow.astro';
import { apps } from '../data/apps';

const count = String(apps.length).padStart(2, '0');
---

<Layout
  title="Made With Pixels: small, useful mobile apps"
  description="Made With Pixels builds small, useful mobile apps. Browse the catalog and get them on Google Play."
>
  <section class="mx-auto w-full max-w-3xl px-4 pt-12 pb-10 sm:px-6 md:pt-16 lg:pt-24 lg:pb-14">
    <p class="mb-4 font-mono text-xs leading-[1.5] tracking-[0.12em] text-mute uppercase">Made With Pixels</p>
    <h1 class="text-[2.5rem] leading-[1.1] font-semibold text-ink sm:text-[2.75rem] lg:text-[4rem]">
      Building an empire of<br />
      <span class="text-gradient-accent">useful apps.</span>
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-[1.6] text-mute">
      A growing toolkit of small, sharp mobile apps, each one built to do a single job well. More are on the way.
    </p>
  </section>

  <section aria-labelledby="catalog" class="mx-auto w-full max-w-3xl px-4 pb-12 sm:px-6 md:pb-16 lg:pb-24">
    <div class="mb-3 flex items-baseline justify-between font-mono text-xs leading-[1.5] tracking-[0.12em] text-mute uppercase">
      <h2 id="catalog">The catalog</h2>
      <span>{count} apps</span>
    </div>
    <ul class="divide-y divide-hairline overflow-hidden rounded-lg border border-hairline bg-surface">
      {apps.map((app) => <AppRow app={app} />)}
    </ul>
  </section>
</Layout>
