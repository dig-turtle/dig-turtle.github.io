---
import LegalLayout from '../layouts/LegalLayout.astro';
import Chip from '../components/Chip.astro';
import { apps, appsUsing, dataUseInfo, type DataUse } from '../data/apps';

const uses: DataUse[] = ['device', 'ads', 'analytics', 'drive'];

/**
 * The chips under a data-use heading, each linking to its app's page. "On your device" collapses to one
 * "All apps" chip when every app has it; other sections always name their apps, so a reader finds theirs.
 */
const chipsFor = (use: DataUse) =>
  use === 'device' && appsUsing(use).length === apps.length
    ? [{ label: 'All apps' }]
    : appsUsing(use).map((app) => ({ label: app.name, href: app.page }));
---

<LegalLayout
  title="Privacy Policy - Made With Pixels, LLC"
  description="Privacy Policy for every Made With Pixels, LLC app: what stays on your device, ads, analytics and Google Drive."
  heading="Privacy Policy"
  updated="October 2026"
>
  <section>
    <h2>Overview</h2>
    <p>
      Made With Pixels, LLC makes small apps for Android. This policy covers all of them. It is organised by what an app
      does with data. Each section starts with the apps it applies to, and you can tap an app to open its page.
    </p>
  </section>

  <section>
    <h2>Contents</h2>
    <ul>
      {
        uses.map((use) => (
          <li>
            <a href={`#${dataUseInfo[use].anchor}`}>{dataUseInfo[use].label}</a>{' '}
            <span class="text-mute">· {chipsFor(use).map((chip) => chip.label).join(', ')}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2 id="on-device">On Your Device</h2>
    <div class="flex flex-wrap gap-2">{chipsFor('device').map((chip) => <Chip {...chip} />)}</div>
    <p>
      What you enter in our apps is stored on your device. We have no servers of our own, and we never receive it.
      Uninstalling an app deletes its data from your device.
    </p>
    <p>
      When you share a link to one of our apps, it opens that link on the site you choose,
      and that site's own privacy policy applies.
    </p>
  </section>

  <section>
    <h2 id="ads">Ads</h2>
    <div class="flex flex-wrap gap-2">{chipsFor('ads').map((chip) => <Chip {...chip} />)}</div>
    <p>
      Our apps show ads from Google AdMob. We don't use any other ad network. To show ads, measure them and limit how
      often you see them, AdMob may collect your device's advertising ID, device information, your IP address and how
      you interact with ads.
    </p>
    <p>
      If you are in the EEA or the UK, the app asks for your consent before it shows ads. You can reset or delete your
      advertising ID at any time in your Android settings.
    </p>
    <p>Ads in Lodestra are never targeted using the contents of your trips or your Google Drive data.</p>
    <p>
      Google explains <a href="https://policies.google.com/technologies/partner-sites"
        >how it uses information from sites or apps that use its services</a
      >. Its handling of this data is covered by the <a href="https://policies.google.com/privacy">Google Privacy Policy</a>.
    </p>
  </section>

  <section>
    <h2 id="analytics">Analytics</h2>
    <div class="flex flex-wrap gap-2">{chipsFor('analytics').map((chip) => <Chip {...chip} />)}</div>
    <p>
      The app sends usage events to PostHog so we can see what works and fix what breaks. These events are the screens
      you view, the features you use, crashes and errors, the app version, and your device model and OS version.
    </p>
    <p>
      Events carry a random ID created when you install the app. That ID is not tied to your name, your email or your
      Google account. The contents of your trips and your Google Drive data are never sent.
    </p>
    <p>
      PostHog stores these events for us. Its handling of them is covered by
      <a href="https://posthog.com/privacy">PostHog's privacy policy</a>.
    </p>
  </section>

  <section>
    <h2 id="google-drive">Google Sign-In and Google Drive</h2>
    <div class="flex flex-wrap gap-2">{chipsFor('drive').map((chip) => <Chip {...chip} />)}</div>
    <p>
      Lodestra keeps your trips in your own Google Drive, not on a server of ours. It's your Drive, and you're in control
      of that data.
    </p>
    <p>
      If you turn on backup, Lodestra asks you to sign in with Google and to allow access to Google Drive. It uses two
      limited permissions:
    </p>
    <ul>
      <li>
        <strong>App data folder</strong> (<code>drive.appdata</code>): a hidden folder in your Drive that only Lodestra
        can see, used for backups and app settings.
      </li>
      <li>
        <strong>Files Lodestra creates or you open with it</strong> (<code>drive.file</code>): Lodestra can only see
        files it created or that you chose to open with it. It cannot see the rest of your Drive.
      </li>
    </ul>
    <p>
      This data goes directly between your device and Google; we never receive it. Google's handling of it is covered by
      the <a href="https://policies.google.com/privacy">Google Privacy Policy</a>. Lodestra's use of information received
      from Google APIs adheres to the <a href="https://developers.google.com/terms/api-services-user-data-policy"
        >Google API Services User Data Policy</a
      >, including the Limited Use requirements. Your Drive data is never used for ads or analytics.
    </p>

    <h3>Sharing a Trip</h3>
    <p>
      When you share a trip, Lodestra uses Google Drive to give the people you choose access to that trip's file, as a
      viewer or an editor. Their email address is used only to grant that access. The invite link you send contains the
      trip's name and your display name, which anyone you send it to can read. The link alone does not give access to
      the trip.
    </p>

    <h3>Deleting Your Drive Data</h3>
    <p>
      To delete your backup, open Google Drive on the web → Settings → Manage apps → Lodestra → Delete hidden app data.
      Trip files in the <em>Lodestra</em> folder of your Drive can be deleted like any other file. You can remove
      Lodestra's access to your Google account at
      <a href="https://myaccount.google.com/permissions">myaccount.google.com/permissions</a>.
    </p>
  </section>

  <section>
    <h2 id="what-we-dont-do">What We Don't Do</h2>
    <ul>
      <li>We don't sell your information or share it with data brokers.</li>
      <li>We don't use your Google Drive data for ads or analytics.</li>
      <li>We don't send what you enter in our apps to any server of ours.</li>
    </ul>
  </section>

  <section>
    <h2 id="deleting-your-data">Deleting Your Data</h2>
    <p>
      Uninstalling an app deletes the data it stored on your device. To delete Lodestra's data in your Google Drive,
      follow the steps under <a href="#google-drive">Google Sign-In and Google Drive</a>. To reset or delete your
      advertising ID, open your Android settings.
    </p>
  </section>

  <section>
    <h2 id="childrens-privacy">Children's Privacy</h2>
    <p>Our apps are not directed at children under the age of 13.</p>
  </section>

  <section>
    <h2 id="changes">Changes to This Policy</h2>
    <p>
      We may update this policy from time to time. When we do, we will post the new version on this page and update the
      "Last updated" date.
    </p>
  </section>

  <section>
    <h2 id="contact">Contact Us</h2>
    <p>
      If you have any questions about this Privacy Policy, please contact us at <a href="mailto:brillianceanimationstudios@gmail.com">brillianceanimationstudios@gmail.com</a>.
    </p>
  </section>
</LegalLayout>
